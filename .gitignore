# ==============================================================================
# Project 4 — Functional Data Catalog
# ==============================================================================
# Principle: track the sources and the seed data; ignore anything the program
# or the tools generate. If a file can be reproduced by running the code, it
# does not belong in version control.
# ==============================================================================


# ------------------------------------------------------------------------------
# Generated by the program itself (Iteration 7 — persistence and reporting)
# ------------------------------------------------------------------------------
# save-catalog, write-report and the io test suite all write into data/.
# Everything there is ignored EXCEPT the seed dataset, which is source.
data/*
!data/sample-catalog.txt
!data/.gitkeep

# Belt and braces: these names are ignored wherever they appear.
*.db
report.txt
test-roundtrip.db


# ------------------------------------------------------------------------------
# Scheme implementation artifacts
# ------------------------------------------------------------------------------

# Racket / DrRacket
compiled/
*.zo
*.dep
*.rkt~

# Guile (guild compile)
*.go

# Chez Scheme (compile-file, whole-program optimization)
*.so
*.wpo

# CHICKEN
# NOTE: CHICKEN also emits .c files next to the sources. They are NOT ignored
# here, because blanket-ignoring *.c is dangerous in any project that might
# later contain hand-written C. Add it yourself if you compile with CHICKEN.
*.import.scm
*.link
*.o

# Gambit
*.o[0-9]*

# MIT/GNU Scheme
*.com
*.bin
*.bci
*.ext
*.fni


# ------------------------------------------------------------------------------
# Editors
# ------------------------------------------------------------------------------

# Emacs — backups, autosaves and lock files. Very common when editing Scheme.
*~
\#*\#
.\#*

# Vim
*.swp
*.swo
Session.vim

# VS Code — remove this line if you want to share workspace settings with a
# teammate or a marker.
.vscode/

# JetBrains
.idea/
*.iml

# Generic backups
*.bak
*.orig


# ------------------------------------------------------------------------------
# Operating system
# ------------------------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
._*

# Linux
.Trash-*


# ------------------------------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------------------------------
*.log
*.tmp
